.pytest_cache/
*.pyc
*.pyo
.ruff_cache/
.mypy_cache/

# Couverture de tests
.coverage
.coverage.*
htmlcov/
coverage.json

# Packaging local
bibops.egg-info/
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# Logs et traces runtime
logs/
data/runtime/**/*.json
data/runtime/**/*.jsonl

# Bases locales et vector stores générés
data/databases/*.db
data/databases/vectordb/
src/data/

# Artefacts générés par les benchmarks (runs locaux)
data/outputs/benchmark/charts/
data/outputs/benchmark/kaggle/
data/outputs/eval_bank/

